<%- include('partials/header') %>

<div class="card shadow-sm">
    <div class="card-header bg-success text-white">
        <h3 class="mb-0">SAML Profile</h3>
    </div>
    <div class="card-body">
        <h5 class="card-title">User Information</h5>
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Attribute</th>
                        <th>Value</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (user.nameID) { %>
                        <tr>
                            <td><strong>NameID</strong></td>
                            <td><%= user.nameID %></td>
                        </tr>
                    <% } %>
                    <% Object.keys(user).forEach(function(key) { %>
                        <% if (key !== 'nameID' && key !== 'issuer' && key !== 'sessionIndex' && key !== 'nameIDFormat') { %>
                            <tr>
                                <td><strong><%= key %></strong></td>
                                <td><%= JSON.stringify(user[key]) %></td>
                            </tr>
                        <% } %>
                    <% }); %>
                </tbody>
            </table>
        </div>

        <hr class="my-4">

        <h5 class="card-title">Raw JSON</h5>
        <div class="bg-light p-3 rounded border">
            <pre class="mb-0"><code><%= JSON.stringify(user, null, 2) %></code></pre>
        </div>

        <div class="mt-3">
            <a href="/" class="btn btn-secondary">Back to Home</a>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
