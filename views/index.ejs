<%- include('partials/header') %>

<div class="row justify-content-center">
    <div class="col-md-8 text-center">
        <h1 class="display-4 mb-4">Welcome</h1>
        <p class="lead text-muted">Select an authentication method to continue.</p>

        <div class="d-grid gap-3 col-md-6 mx-auto mt-5">
            <% if (!user && !oidcUser && !uaePassUser) { %>
                <a href="/login" class="btn btn-primary btn-lg shadow-sm">
                    Log in with SAML
                </a>
                <a href="/login/oidc" class="btn btn-outline-primary btn-lg shadow-sm">
                    Log in with OIDC
                </a>
            <% } else { %>
                <div class="alert alert-success">
                    <h4 class="alert-heading">You are logged in!</h4>
                    <p>Welcome back.</p>
                    <hr>
                    <div class="d-flex justify-content-center gap-3">
                        <% if (user) { %>
                            <a href="/profile" class="btn btn-success">View SAML Profile</a>
                        <% } %>
                        <% if (oidcUser) { %>
                            <a href="/profile-oidc" class="btn btn-info text-white">View OIDC Profile</a>
                        <% } %>
                        <% if (uaePassUser) { %>
                            <a href="/profile-uaepass" class="btn btn-dark">View UAE Pass Profile</a>
                        <% } %>
                        <a href="/logout" class="btn btn-danger">Logout</a>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
